{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zkc.dev/schemas/compliance-proof-v2.schema.json",
  "title": "ZKC ComplianceProof v2",
  "description": "Presentation-profile envelope (design §3). Replaces v1's global holderBinding with a presentationBinding block carrying the anonymous or scoped profile. holderBinding is forbidden; it exists only in v1 (linkable) envelopes.",
  "type": "object",
  "required": ["version", "metadata", "proofs", "presentationBinding"],
  "not": { "required": ["holderBinding"] },
  "properties": {
    "version": { "const": "zkc:proof:v2" },
    "metadata": {
      "type": "object",
      "required": ["generatedAt", "expiresAt", "context"],
      "properties": {
        "generatedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "context": {
          "type": "object",
          "required": ["profile", "value", "timestamp"],
          "properties": {
            "profile": { "type": "string" },
            "value": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
            "timestamp": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "proofs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["proofType", "proof", "publicInputs", "principalConsent"],
        "properties": {
          "proofType": { "type": "string" },
          "proof": { "type": "string" },
          "publicInputs": { "type": "object" },
          "principalConsent": { "type": "boolean" }
        }
      }
    },
    "presentationBinding": {
      "type": "object",
      "required": ["profile"],
      "oneOf": [
        {
          "description": "Anonymous profile: no holder-derived handle.",
          "required": ["profile"],
          "not": {
            "anyOf": [
              { "required": ["pseudonym"] },
              { "required": ["scopeId"] }
            ]
          },
          "properties": {
            "profile": { "const": "zkc:presentation:anonymous:v1" }
          }
        },
        {
          "description": "Scoped profile: presentation_pseudonym + scope_id, cross-checked against every proof's public inputs.",
          "required": ["profile", "pseudonym", "scopeId"],
          "properties": {
            "profile": { "const": "zkc:presentation:scoped:v1" },
            "pseudonym": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
            "scopeId": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" }
          }
        }
      ]
    },
    "aggregation": {
      "type": "object",
      "required": [
        "proof",
        "inputProofCommitments",
        "aggregationCommitment",
        "aggregatedClaimBinding"
      ],
      "properties": {
        "proof": { "type": "string" },
        "inputProofCommitments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" }
        },
        "aggregationCommitment": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$",
          "description": "Public input `aggregation_commitment` of zkc_aggregation_v2; aggregatedClaimBinding = H(aggregationCommitment, context)"
        },
        "aggregatedClaimBinding": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" }
      }
    }
  }
}
