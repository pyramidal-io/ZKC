{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zkc.dev/schemas/credential-runtime-attestation-v1.schema.json",
  "title": "ZKC Runtime Attestation Credential Claims v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attestedManifestDigest",
    "rootClass",
    "rootAuthorityIdentifier",
    "rootMaterialDigest",
    "attestationEvidenceDigest",
    "verificationPolicyDigest",
    "validFrom",
    "validUntil"
  ],
  "properties": {
    "attestedManifestDigest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "rootClass": {
      "enum": ["root:build-provenance", "root:tee-attestation"]
    },
    "rootAuthorityIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "$comment": "JSON Schema maxLength counts Unicode code points; the normative issuer contract additionally enforces at most 256 UTF-8 bytes."
    },
    "rootMaterialDigest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "attestationEvidenceDigest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "verificationPolicyDigest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "validFrom": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "validUntil": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    }
  }
}
