{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zkc.dev/schemas/issuer-metadata.schema.json",
  "title": "ZKC Issuer Metadata",
  "type": "object",
  "required": [
    "version",
    "issuerId",
    "displayName",
    "signingKeys",
    "supportedSchemas",
    "adapter",
    "revocation",
    "serviceLevels"
  ],
  "properties": {
    "version": {
      "enum": ["zkc:issuer-metadata:v1", "zkc:issuer-metadata:v2"]
    },
    "issuerId": { "type": "string", "pattern": "^zkc:issuer:[a-z0-9._-]+$" },
    "displayName": { "type": "string", "minLength": 1 },
    "signingKeys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["keyId", "scheme", "publicKey", "notBefore", "notAfter"],
        "properties": {
          "keyId": { "type": "string", "minLength": 1 },
          "scheme": { "enum": ["ECDSA_SECP256K1", "BLS", "Schnorr"] },
          "publicKey": { "type": "string", "minLength": 1 },
          "attributeLayoutId": {
            "description": "The one attribute layout this exact signing key attests for legacy attribute-set credentials, encoded as a nonzero canonical field element.",
            "type": "string",
            "maxLength": 66,
            "pattern": "^0x(?!0{64})[0-9a-f]{64}$"
          },
          "notBefore": { "type": "string", "format": "date-time" },
          "notAfter": { "type": "string", "format": "date-time" }
        }
      }
    },
    "supportedSchemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["schemaId", "credentialType", "proofType"],
        "properties": {
          "schemaId": { "type": "string", "minLength": 1 },
          "credentialType": { "type": "string", "minLength": 1 },
          "proofType": { "type": "string", "minLength": 1 },
          "codeSpaceIds": {
            "description": "Closed issuer allowlist of exact locally registered namespaces for this schema.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^0x(?!0{64})[0-9a-f]{64}$" }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "schemaId": { "enum": [
              "zkc:cred:jurisdiction:v2", "zkc:cred:source:v3",
              "zkc:cred:tax:v3", "zkc:cred:sanctions:v3"
            ] } }, "required": ["schemaId"] },
            "then": { "required": ["codeSpaceIds"] },
            "else": { "not": { "required": ["codeSpaceIds"] } }
          },
          {
            "if": { "anyOf": [
              { "properties": { "schemaId": { "const": "zkc:cred:jurisdiction:v2" } }, "required": ["schemaId"] },
              { "properties": { "credentialType": { "const": "zkc:cred:jurisdiction:v2" } }, "required": ["credentialType"] }
            ] },
            "then": {
              "required": ["codeSpaceIds"],
              "properties": {
                "schemaId": { "const": "zkc:cred:jurisdiction:v2" },
                "credentialType": { "const": "zkc:cred:jurisdiction:v2" },
                "proofType": { "const": "zkc:proof:jurisdiction:v6" },
                "codeSpaceIds": { "items": { "enum": [
                  "0x2a08f1081f6d4cb9903e407e429e3d7db8c3b6ea5745f7017dcbd33f7812159c"
                ] } }
              }
            }
          },
          {
            "if": { "anyOf": [
              { "properties": { "schemaId": { "const": "zkc:cred:source:v3" } }, "required": ["schemaId"] },
              { "properties": { "credentialType": { "const": "zkc:cred:source:v3" } }, "required": ["credentialType"] }
            ] },
            "then": {
              "required": ["codeSpaceIds"],
              "properties": {
                "schemaId": { "const": "zkc:cred:source:v3" },
                "credentialType": { "const": "zkc:cred:source:v3" },
                "proofType": { "const": "zkc:proof:source:v11" },
                "codeSpaceIds": { "items": { "enum": [
                  "0x24f3df0605f40ece44f2b6aa39507e6bfd5440f85c9646188caea9d3646077d5"
                ] } }
              }
            }
          },
          {
            "if": { "anyOf": [
              { "properties": { "schemaId": { "const": "zkc:cred:tax:v3" } }, "required": ["schemaId"] },
              { "properties": { "credentialType": { "const": "zkc:cred:tax:v3" } }, "required": ["credentialType"] }
            ] },
            "then": {
              "required": ["codeSpaceIds"],
              "properties": {
                "schemaId": { "const": "zkc:cred:tax:v3" },
                "credentialType": { "const": "zkc:cred:tax:v3" },
                "proofType": { "const": "zkc:proof:tax:v11" },
                "codeSpaceIds": { "items": { "enum": [
                  "0x2f15daadfe2a6c50205155f5f2ac8c0b71d7fc69549fdd88eb86b865f1d79e2f"
                ] } }
              }
            }
          },
          {
            "if": { "anyOf": [
              { "properties": { "schemaId": { "const": "zkc:cred:sanctions:v3" } }, "required": ["schemaId"] },
              { "properties": { "credentialType": { "const": "zkc:cred:sanctions:v3" } }, "required": ["credentialType"] }
            ] },
            "then": {
              "required": ["codeSpaceIds"],
              "properties": {
                "schemaId": { "const": "zkc:cred:sanctions:v3" },
                "credentialType": { "const": "zkc:cred:sanctions:v3" },
                "proofType": { "const": "zkc:proof:sanctions:v11" },
                "codeSpaceIds": { "items": { "enum": [
                  "0x09ff1a53d43d90a6dd8b29779cacfbfec3b110e9fa5790a1920d67613f6530b2",
                  "0x2baab6a163ff3b3b63dd2d0e8548c284bcac1f5390a65ea24a94097deb6398aa"
                ] } }
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": { "properties": { "schemaId": { "const": "zkc:cred:jurisdiction:v2" } }, "required": ["schemaId"] },
          "minContains": 0, "maxContains": 1
        },
        {
          "contains": { "properties": { "schemaId": { "const": "zkc:cred:source:v3" } }, "required": ["schemaId"] },
          "minContains": 0, "maxContains": 1
        },
        {
          "contains": { "properties": { "schemaId": { "const": "zkc:cred:tax:v3" } }, "required": ["schemaId"] },
          "minContains": 0, "maxContains": 1
        },
        {
          "contains": { "properties": { "schemaId": { "const": "zkc:cred:sanctions:v3" } }, "required": ["schemaId"] },
          "minContains": 0, "maxContains": 1
        }
      ]
    },
    "adapter": {
      "type": "object",
      "required": [
        "verifySubjectEndpoint",
        "bindHolderCommitmentEndpoint",
        "issueCredentialEndpoint",
        "publishRevocationHandleEndpoint"
      ],
      "properties": {
        "verifySubjectEndpoint": { "type": "string", "format": "uri" },
        "bindHolderCommitmentEndpoint": { "type": "string", "format": "uri" },
        "issueCredentialEndpoint": { "type": "string", "format": "uri" },
        "publishRevocationHandleEndpoint": { "type": "string", "format": "uri" }
      }
    },
    "revocation": {
      "type": "object",
      "required": [
        "accumulatorId",
        "type",
        "currentRoot",
        "currentEpoch",
        "maxEpochLag",
        "updateEndpoint"
      ],
      "properties": {
        "accumulatorId": { "type": "string", "minLength": 1 },
        "type": { "const": "POSEIDON2_MERKLE_ACTIVE_SET" },
        "currentRoot": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
        "currentEpoch": { "type": "integer", "minimum": 0 },
        "maxEpochLag": { "type": "integer", "minimum": 0 },
        "updateEndpoint": { "type": "string", "format": "uri" },
        "currentAnnouncement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "accumulatorId",
            "root",
            "epoch",
            "announcedAt",
            "maxEpochLag",
            "signingKeyId",
            "previousAnnouncementHash",
            "signature"
          ],
          "properties": {
            "version": { "const": "zkc:epoch-announcement:v3" },
            "accumulatorId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65535,
              "$comment": "JSON Schema maxLength counts Unicode code points. The normative bound is 1..65535 UTF-8 bytes, and the signing transcript must stay within 65535 bytes, so accumulatorId and signingKeyId together hold at most 65392 UTF-8 bytes (docs/zkc_specification.md section 2.4.1)."
            },
            "root": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
            "epoch": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
            "announcedAt": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
            "maxEpochLag": { "type": "integer", "minimum": 0, "maximum": 10 },
            "signingKeyId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65535,
              "$comment": "JSON Schema maxLength counts Unicode code points. The normative bound is 1..65535 UTF-8 bytes, and the signing transcript must stay within 65535 bytes, so accumulatorId and signingKeyId together hold at most 65392 UTF-8 bytes (docs/zkc_specification.md section 2.4.1)."
            },
            "previousAnnouncementHash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
            "signature": { "type": "string", "pattern": "^0x[0-9a-f]{128}$" }
          }
        },
        "currentLiveness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "accumulatorId",
            "epoch",
            "headHash",
            "issuedAt",
            "signingKeyId",
            "signature"
          ],
          "properties": {
            "version": { "const": "zkc:epoch-liveness:v1" },
            "accumulatorId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65535,
              "$comment": "JSON Schema maxLength counts Unicode code points. The normative bound is 1..65535 UTF-8 bytes, and the liveness signing transcript must stay within 65535 bytes, so accumulatorId and signingKeyId together hold at most 65440 UTF-8 bytes (docs/zkc_specification.md section 2.4.2)."
            },
            "epoch": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
            "headHash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
            "issuedAt": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
            "signingKeyId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65535,
              "$comment": "JSON Schema maxLength counts Unicode code points. The normative bound is 1..65535 UTF-8 bytes, and the liveness signing transcript must stay within 65535 bytes, so accumulatorId and signingKeyId together hold at most 65440 UTF-8 bytes (docs/zkc_specification.md section 2.4.2)."
            },
            "signature": { "type": "string", "pattern": "^0x[0-9a-f]{128}$" }
          }
        }
      }
    },
    "serviceLevels": {
      "type": "object",
      "required": [
        "maxRevocationPropagationSeconds",
        "expectedIssuanceLatencySeconds",
        "metadataCacheSeconds"
      ],
      "properties": {
        "maxRevocationPropagationSeconds": { "type": "integer", "minimum": 0 },
        "expectedIssuanceLatencySeconds": { "type": "integer", "minimum": 0 },
        "metadataCacheSeconds": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "supportedSchemas": {
            "contains": {
              "properties": { "schemaId": { "const": "zkc:cred:attribute-set:v1" } },
              "required": ["schemaId"]
            }
          }
        }
      },
      "then": {
        "properties": {
          "signingKeys": { "contains": { "required": ["attributeLayoutId"] } }
        }
      }
    },
    {
      "if": {
        "properties": { "version": { "const": "zkc:issuer-metadata:v2" } },
        "required": ["version"]
      },
      "then": {
        "properties": {
          "revocation": { "required": ["currentAnnouncement"] }
        }
      },
      "else": {
        "properties": {
          "revocation": {
            "allOf": [
              { "not": { "required": ["currentAnnouncement"] } },
              { "not": { "required": ["currentLiveness"] } }
            ]
          }
        }
      }
    }
  ]
}
