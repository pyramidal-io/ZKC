{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zkc.dev/schemas/compliance-proof-v1.schema.json",
  "title": "ZKC ComplianceProof v1",
  "type": "object",
  "required": ["version", "metadata", "proofs", "holderBinding"],
  "properties": {
    "version": { "const": "zkc:proof:v1" },
    "metadata": {
      "type": "object",
      "required": ["generatedAt", "expiresAt", "context"],
      "properties": {
        "generatedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "context": {
          "type": "object",
          "required": ["profile", "value", "timestamp"],
          "properties": {
            "profile": { "type": "string" },
            "value": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
            "timestamp": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "proofs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["proofType", "proof", "publicInputs", "principalConsent"],
        "properties": {
          "proofType": { "type": "string" },
          "proof": { "type": "string" },
          "publicInputs": { "type": "object" },
          "principalConsent": { "type": "boolean" }
        }
      }
    },
    "holderBinding": {
      "type": "object",
      "required": ["commitment"],
      "properties": {
        "commitment": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" }
      }
    },
    "aggregation": {
      "type": "object",
      "required": [
        "proof",
        "inputProofCommitments",
        "aggregationCommitment",
        "aggregatedClaimBinding"
      ],
      "properties": {
        "proof": { "type": "string" },
        "inputProofCommitments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" }
        },
        "aggregationCommitment": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$",
          "description": "Public input `aggregation_commitment` of zkc_aggregation; aggregatedClaimBinding = H(aggregationCommitment, context)"
        },
        "aggregatedClaimBinding": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" }
      }
    }
  }
}
