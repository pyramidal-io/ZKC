# Canonical Noir toolchain versions for ZKC development and artifact builds.
#
# Committed registry identities are rebuilt with HISTORICAL_* forever.  New
# package identities may use SUCCESSOR_*.  The package-to-toolchain mapping is
# maintained outside the immutable registry entries in noir/toolchains.json.
# BB_VERSION must be the Barretenberg release pinned by noir-lang/noir for the
# matching Nargo release.
HISTORICAL_NARGO_VERSION=1.0.0-beta.21
HISTORICAL_BB_VERSION=5.0.0-nightly.20260324
SUCCESSOR_NARGO_VERSION=1.0.0-beta.25
SUCCESSOR_BB_VERSION=5.0.0

# Compatibility aliases for historical-only commands and evidence checks.
# Keep these literals: several stdlib scripts parse this file without a shell.
NARGO_VERSION=1.0.0-beta.21
BB_VERSION=5.0.0-nightly.20260324
